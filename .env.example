# Solo para docker-compose.yml (despliegue en contenedores). No es el
# .env del backend en desarrollo local (ver backend/.env.example): ese
# apunta a un Postgres propio en el host (puerto 5433) fuera de este
# compose. Copiar a ".env" en la raíz y completar. Nunca commitear ".env".

# Credenciales del servicio "db" del compose (Postgres 16 en contenedor).
DB_USER=
DB_PASSWORD=
DB_NAME=
