# Frontend React + Vite. Copiar a frontend/.env y completar. Nunca commitear .env.
# Variables que lee src/ (axios.js, prospectos.js, AuthContext.jsx, Login.jsx). Si el código lee otra, falta aquí.
# Todo lo que empieza por VITE_ queda visible en el navegador: nunca poner secretos aquí.

# URL del backend. Opcional: si falta, el código usa http://localhost:8000.
VITE_API_URL=http://localhost:8000

# true = usa datos locales (src/mocks) en vez del backend; false = backend real. Opcional.
VITE_USE_MOCK=false
