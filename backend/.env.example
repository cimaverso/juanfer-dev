# Backend FastAPI. Copiar a backend/.env y completar. Nunca commitear .env.
# Variables que lee app/core/config.py. Si el código lee otra, falta aquí.

# Conexión a PostgreSQL con driver psycopg 3 (SQLAlchemy síncrono). Contenedor local: puerto 5433.
# Si la clave tiene caracteres especiales, codificarla en URL (por ejemplo %40 para @).
DATABASE_URL=postgresql+psycopg://usuario:clave@127.0.0.1:5433/nombre_db

# Clave para firmar los JWT. Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
